        "text": "=Research this company: {{ $json.body.company_name }}, website: {{ $json.body.website }}, city: {{ $json.body.city }}",
        "options": {
          "systemMessage": "You are a Lead Researcher who researches HVAC businesses.\nYour job: from the company's website and the info provided, determine:\n- Services the company offers\n- Service area (city/region)\n- Online presence quality (website, booking, reviews)\n- Possible pain points that AI automation could solve\n\nOnly state facts. If information is not found, write \"not found\".\nOutput: plain text, 4-6 lines."
        }
      },
